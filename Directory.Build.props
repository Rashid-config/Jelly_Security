<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.21.1.0</Version>
    <AssemblyVersion>0.21.1.0</AssemblyVersion>
    <FileVersion>0.21.1.0</FileVersion>
    <Authors>RASHID AL SAIDI</Authors>
    <Company>Jelly Security</Company>
    <Product>Jelly Security</Product>
    <Copyright>Copyright (c) 2026 RASHID AL SAIDI</Copyright>
  </PropertyGroup>
</Project>
